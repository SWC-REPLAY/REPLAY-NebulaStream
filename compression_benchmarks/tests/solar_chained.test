# name: compression_benchmarks/solar_chained.test
# description: The full tier chain over the FULL DEBS solar panel readings -- the chained
#              counterpart to solar_standalone.test, and the large-scale control for
#              wind_chained.test.
# groups: [StoreBench]
#
# Input: 42,700,000 rows x 28 bytes = 1,195,600,000 bytes. See solar_standalone.test's header for
# what makes this data hostile to compression; the short version is a producerId that is a shuffled
# permutation of the row numbers and a timestamp with no repeating delta.
#
# MemoryStore -> FileStore -> {CompressedStore, LossyStore}. Unlike solar_standalone.test,
# MemoryStore belongs here: it is the head of a chain, so it DRAINS into FileStore rather than
# having to hold the stream. MAX_BUFFER_COUNT is still raised to 2048 for the same reason it is in
# wind_chained.test -- so the ring drains rather than wrapping between flushes.
#
# FILESTORE'S CAPACITY IS LEFT AT ITS DEFAULT, unlike the standalone run, and that is deliberate.
# The flush threshold is DERIVED as totalSize / filesAtCapacity, which at the 64 MB default over 16
# files is 4 MB. FileStore therefore migrates every 4 MB and never accumulates, so it cannot evict
# whatever its capacity says. Raising capacity to the 4 GB the standalone run needs would raise the
# threshold to 1 GB, and FileStore would sit on nearly the entire dataset UNCOMPRESSED while the
# tail saw almost nothing -- a chain in name only. It also keeps this comparable with the wind
# chained numbers, which ran at the same default.
#
# EVERY SINK IS VOID. Same trade as solar_standalone.test: a lossy read-back's checksum depends on
# the group size, which the sweep varies, so pinning one makes the run report failures at every
# point but one. What still catches a broken run is the per-tier byte count the bench script reads
# off the store files.

SEQUENTIAL_EXECUTION

CREATE LOGICAL SOURCE ch_comp(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_comp TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE ch_exact(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_exact TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE ch_b01(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b01 TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE ch_b1(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b1 TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE ch_b5(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b5 TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE SINK wComp(ch_comp.producerId INT32, ch_comp.groupId INT32, ch_comp.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK rComp(ch_comp.producerId INT32, ch_comp.groupId INT32, ch_comp.producedPower FLOAT64, ch_comp.ts UINT64) TYPE Void;
CREATE SINK wExact(ch_exact.producerId INT32, ch_exact.groupId INT32, ch_exact.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK rExact(ch_exact.producerId INT32, ch_exact.groupId INT32, ch_exact.producedPower FLOAT64, ch_exact.ts UINT64) TYPE Void;
CREATE SINK wB01(ch_b01.producerId INT32, ch_b01.groupId INT32, ch_b01.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK rB01(ch_b01.producerId INT32, ch_b01.groupId INT32, ch_b01.producedPower FLOAT64, ch_b01.ts UINT64) TYPE Void;
CREATE SINK wB1(ch_b1.producerId INT32, ch_b1.groupId INT32, ch_b1.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK rB1(ch_b1.producerId INT32, ch_b1.groupId INT32, ch_b1.producedPower FLOAT64, ch_b1.ts UINT64) TYPE Void;
CREATE SINK wB5(ch_b5.producerId INT32, ch_b5.groupId INT32, ch_b5.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK rB5(ch_b5.producerId INT32, ch_b5.groupId INT32, ch_b5.producedPower FLOAT64, ch_b5.ts UINT64) TYPE Void;


# ---- lossless chain, zstd tail ----------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_comp INTO wComp
REPLAYABLE WITH HISTORY OF '1MB' SET(
    'MemoryStore->FileStore->CompressedStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----

SELECT producerId, groupId, producedPower, ts FROM ch_comp
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rComp;
----


# ---- lossy chain, no bound: columnar and bit-packed, still lossless ----------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_exact INTO wExact
REPLAYABLE WITH HISTORY OF '1MB' SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----

SELECT producerId, groupId, producedPower, ts FROM ch_exact
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rExact;
----


# ---- lossy chain, 0.1% ------------------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b01 INTO wB01
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 0.1% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----

SELECT producerId, groupId, producedPower, ts FROM ch_b01
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB01;
----


# ---- lossy chain, 1% --------------------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b1 INTO wB1
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 1% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----

SELECT producerId, groupId, producedPower, ts FROM ch_b1
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB1;
----


# ---- lossy chain, 5% --------------------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b5 INTO wB5
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 5% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----

SELECT producerId, groupId, producedPower, ts FROM ch_b5
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB5;
----
