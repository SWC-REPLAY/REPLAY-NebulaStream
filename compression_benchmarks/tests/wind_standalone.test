# name: compression_benchmarks/wind_standalone.test
# description: CompressedStore and LossyStore standing alone, at several accuracy bounds, over the
#              200,001-row DEBS wind turbine readings.
# groups: [StoreBench]
#
# Input: 200,001 rows x 28 bytes = 5,600,028 bytes.
#
# 28 bytes is the stored row width, not the CSV's: INT32,INT32,FLOAT64,UINT64 each carry a null
# indicator byte, so (4+1)+(4+1)+(8+1)+(8+1).
#
# At a 64 KB group that is ~85 groups, against the 1.34 the small file gave -- enough that per-group
# overhead is amortised the way it would be in a real store rather than dominating.
#
# bytes_out is the FILE SIZE, overhead included. Neither of these two tiers preallocates a segment
# table -- both write their index inline, one header per unit -- so everything counted is
# proportional to what was actually stored. A format's own overhead is a real cost on disk and
# subtracting it would flatter the ratio.
#
# LossyStore with no bound is here as the separator: it isolates what the columnar layout and
# bit-packing buy before any accuracy is spent, so the remaining configurations show what the bound
# adds on top.
#
# The three BOUNDED-LOSSY read-backs use a Void sink and assert nothing. A lossy read-back's
# checksum is a function of the quantisation, the quantisation is a function of the group size, and
# the group size is exactly what grid.py sweeps -- so a pinned value is correct at one point of the
# sweep and wrong at every other. Pinning them meant this file reported three failures at four of
# five grid points, unnoticed, because the bench script never checks the exit status.
#
# Everything else stays pinned. The write queries and the LOSSLESS read-backs are byte-exact
# whatever the group size, so they still catch a run that drops or reorders rows.

SEQUENTIAL_EXECUTION

CREATE LOGICAL SOURCE wind_comp(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_comp TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE wind_exact(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_exact TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE wind_b01(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_b01 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE wind_b1(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_b1 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE wind_b5(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_b5 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE SINK wComp(wind_comp.producerId INT32, wind_comp.groupId INT32, wind_comp.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rComp(wind_comp.producerId INT32, wind_comp.groupId INT32, wind_comp.producedPower FLOAT64, wind_comp.ts UINT64) TYPE Checksum;
CREATE SINK wExact(wind_exact.producerId INT32, wind_exact.groupId INT32, wind_exact.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rExact(wind_exact.producerId INT32, wind_exact.groupId INT32, wind_exact.producedPower FLOAT64, wind_exact.ts UINT64) TYPE Checksum;
CREATE SINK wB01(wind_b01.producerId INT32, wind_b01.groupId INT32, wind_b01.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB01(wind_b01.producerId INT32, wind_b01.groupId INT32, wind_b01.producedPower FLOAT64, wind_b01.ts UINT64) TYPE Void;
CREATE SINK wB1(wind_b1.producerId INT32, wind_b1.groupId INT32, wind_b1.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB1(wind_b1.producerId INT32, wind_b1.groupId INT32, wind_b1.producedPower FLOAT64, wind_b1.ts UINT64) TYPE Void;
CREATE SINK wB5(wind_b5.producerId INT32, wind_b5.groupId INT32, wind_b5.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB5(wind_b5.producerId INT32, wind_b5.groupId INT32, wind_b5.producedPower FLOAT64, wind_b5.ts UINT64) TYPE Void;


# ---- CompressedStore alone: row-major bytes through zstd ----------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_comp INTO wComp
REPLAYABLE WITH HISTORY OF '1MB' SET('CompressedStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_comp
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rComp;
----
200001 243964861


# ---- LossyStore alone, no bound: columnar and bit-packed, still lossless -------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_exact INTO wExact
REPLAYABLE WITH HISTORY OF '1MB' SET('LossyStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_exact
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rExact;
----
200001 243964861


# ---- LossyStore alone, 0.1% ---------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_b01 INTO wB01
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 0.1%
SET('LossyStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_b01
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB01;
----


# ---- LossyStore alone, 1% -----------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_b1 INTO wB1
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 1%
SET('LossyStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_b1
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB1;
----


# ---- LossyStore alone, 5% -----------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_b5 INTO wB5
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 5%
SET('LossyStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_b5
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB5;
----


# ---- MemoryStore alone -----------------------------------------------------------------------
# MAX_BUFFER_COUNT is raised to 2048 on purpose. Standing alone there is no tier to drain into, so
# the ring EVICTS the oldest buffer when it is full, and the default 128 buffers x 4096 B = 512 KB
# against 5.6 MB of input would silently drop about nine tenths of the rows. 2048 buffers is 8 MB,
# which holds the lot. Nothing is written to disk, so bytes_out is 0 and the ratio is meaningless;
# this configuration is here for the timing and as the no-storage baseline.
CREATE LOGICAL SOURCE wind_mem(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_mem TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE SINK wMem(wind_mem.producerId INT32, wind_mem.groupId INT32, wind_mem.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rMem(wind_mem.producerId INT32, wind_mem.groupId INT32, wind_mem.producedPower FLOAT64, wind_mem.ts UINT64) TYPE Checksum;

SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_mem INTO wMem
REPLAYABLE WITH HISTORY OF '1MB' SET(
    'MemoryStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_mem
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rMem;
----
200001 243964861


# ---- FileStore alone -------------------------------------------------------------------------
# Row-major on disk, no compression, so bytes_out is the input plus the file header and the
# preallocated segment table. The table is sized by FileStore::Config::totalSize, held at 8 MB so
# there are enough slots for 5.6 MB at every segment size in the sweep -- 512 slots at 16 KB down
# to 8 at 1 MB. This is the tier the other two compress against, so its ratio should be just under 1.
CREATE LOGICAL SOURCE wind_file(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wind_file TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE SINK wFile(wind_file.producerId INT32, wind_file.groupId INT32, wind_file.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rFile(wind_file.producerId INT32, wind_file.groupId INT32, wind_file.producedPower FLOAT64, wind_file.ts UINT64) TYPE Checksum;

SELECT producerId, groupId, producedPower, timestamp AS ts FROM wind_file INTO wFile
REPLAYABLE WITH HISTORY OF '1MB' SET('FileStore' AS REPLAY.STORE_ORDER);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM wind_file
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rFile;
----
200001 243964861
