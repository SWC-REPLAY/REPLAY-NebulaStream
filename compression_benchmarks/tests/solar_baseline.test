# The same query with NO store, so a store's cost can be read as a difference rather than quoted
# as an absolute. Two queries over the full 42,700,000-row solar file, both into Void sinks.
#
#   Q1  normal query, 4 columns out   file read + CSV parse + sink
#   Q2  normal query, 1 column out    the same parse, a narrower sink
#
# Why this is a separate file rather than two more queries inside solar_standalone.test: neither
# query touches a store, so neither depends on the unit size the grid is sweeping. Keeping it out
# means solar_standalone.test and solar_chained.test are unchanged, and the numbers they produced
# before stay comparable to the ones they produce now.
#
# The schema matches those tests exactly, nullable included -- four columns, each carrying a
# one-byte null indicator, so a stored row is 28 B and not 24. A baseline measured on a different
# row width would not be subtractable from them.
#
# Q2 exists to answer a question the 4-column query cannot: whether a narrower projection costs
# less. It does not, materially -- the formatter parses every field whether the query selects it or
# not -- and that is worth having measured rather than assumed.

SEQUENTIAL_EXECUTION

CREATE LOGICAL SOURCE sol_plain(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR sol_plain TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE sol_1col(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR sol_1col TYPE File;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE SINK vPlain(sol_plain.producerId INT32, sol_plain.groupId INT32, sol_plain.producedPower FLOAT64, ts UINT64) TYPE Void;
CREATE SINK v1col(sol_1col.producedPower FLOAT64) TYPE Void;


# ---- Q1: normal query, no store ------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM sol_plain INTO vPlain;
----

# ---- Q2: normal query, one column out, no store --------------------------------------------
SELECT producedPower FROM sol_1col INTO v1col;
----
