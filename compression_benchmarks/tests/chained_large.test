# name: compression_benchmarks/chained_large.test
# description: The compression tiers at the bottom of a real chain, MemoryStore->FileStore->X, over
#              the 200,001-row DEBS wind turbine readings.
# groups: [StoreBench]
#
# Input: 200,001 rows x 28 bytes = 5,600,028 bytes.
#
# This is the configuration that actually ships. standalone_large.test writes straight into one tier
# and measures it in isolation, which is the right way to compare codecs but is NOT how a query
# runs: records land in MemoryStore, drain into FileStore when the flush policy trips, and reach the
# compression tier only as whole segments. Everything between the source and the codec -- buffer
# sealing, two transformations, two drains -- is exercised here and nowhere else.
#
# So bytes_out here is the WHOLE CHAIN's footprint, every tier's file added up. Some rows are still
# sitting uncompressed in FileStore when the query ends, which is realistic and is the point: a
# chain's stored size is not its tail tier's ratio.
#
# MAX_BUFFER_COUNT is raised to 2048 on purpose, and not for the reason it is raised in
# standalone_large.test. There, a standalone MemoryStore needs the room or it evicts. Here the ring
# MUST NOT WRAP, because wrapping a chained MemoryStore hits a crash: writeRecord does
# `buffers.push_back(std::move(*active))` and then calls flush() while `activeBuffer` is still
# engaged -- moving out of an optional does not disengage it -- so flush seals a moved-from
# TupleBuffer and dereferences a null control block. 2048 buffers is 8 MB, above the 5.6 MB input,
# so the ring never wraps and the drain happens through the flush policy instead.
#
# That bug predates every branch in this repo and is not exercised by any other test: the systests
# chain but never fill 128 buffers, and standalone_large.test fills them but never chains. Remove
# the MAX_BUFFER_COUNT lines below to reproduce it.

# On sweeping this file with grid_f2.py: vary FILESTORE's segment, not the tail's unit. LossyStore
# seals one group per incoming segment and ignores groupSize when a transformation feeds it, and
# CompressedStore's output depends only on its final block size, not on how many segments merged
# into it. A tail sweep therefore produces rows that are identical to the byte.

SEQUENTIAL_EXECUTION

CREATE LOGICAL SOURCE ch_comp(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_comp TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE ch_exact(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_exact TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE ch_b01(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b01 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE ch_b1(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b1 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE ch_b5(producerId INT32, groupId INT32, producedPower FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ch_b5 TYPE File;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE SINK wComp(ch_comp.producerId INT32, ch_comp.groupId INT32, ch_comp.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rComp(ch_comp.producerId INT32, ch_comp.groupId INT32, ch_comp.producedPower FLOAT64, ch_comp.ts UINT64) TYPE Checksum;
CREATE SINK wExact(ch_exact.producerId INT32, ch_exact.groupId INT32, ch_exact.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rExact(ch_exact.producerId INT32, ch_exact.groupId INT32, ch_exact.producedPower FLOAT64, ch_exact.ts UINT64) TYPE Checksum;
CREATE SINK wB01(ch_b01.producerId INT32, ch_b01.groupId INT32, ch_b01.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB01(ch_b01.producerId INT32, ch_b01.groupId INT32, ch_b01.producedPower FLOAT64, ch_b01.ts UINT64) TYPE Checksum;
CREATE SINK wB1(ch_b1.producerId INT32, ch_b1.groupId INT32, ch_b1.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB1(ch_b1.producerId INT32, ch_b1.groupId INT32, ch_b1.producedPower FLOAT64, ch_b1.ts UINT64) TYPE Checksum;
CREATE SINK wB5(ch_b5.producerId INT32, ch_b5.groupId INT32, ch_b5.producedPower FLOAT64, ts UINT64) TYPE Checksum;
CREATE SINK rB5(ch_b5.producerId INT32, ch_b5.groupId INT32, ch_b5.producedPower FLOAT64, ch_b5.ts UINT64) TYPE Checksum;


# ---- lossless chain: MemoryStore -> FileStore -> CompressedStore -------------------------------
# The read-back checksum is the INPUT checksum, exactly. A lossless chain that returns anything else
# has lost or reordered rows, so this assertion is worth more than the lossy ones below.
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_comp INTO wComp
REPLAYABLE WITH HISTORY OF '1MB' SET(
    'MemoryStore->FileStore->CompressedStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM ch_comp
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rComp;
----
200001 243964861


# ---- lossy chain, no bound: columnar and bit-packed, still lossless ----------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_exact INTO wExact
REPLAYABLE WITH HISTORY OF '1MB' SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM ch_exact
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rExact;
----
200001 243964861


# ---- lossy chain, 0.1% ------------------------------------------------------------------------
# The read-back checksums below are OBSERVED, not derived: a bound says how far a value may move,
# not where it lands, so there is no independent way to predict the sum. The row count is the real
# invariant -- it must be 200001 -- and the checksum is pinned so a change in the quantiser shows up
# instead of passing silently.
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b01 INTO wB01
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 0.1% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM ch_b01
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB01;
----
200001 285746648


# ---- lossy chain, 1% --------------------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b1 INTO wB1
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 1% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM ch_b1
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB1;
----
200001 285763756


# ---- lossy chain, 5% --------------------------------------------------------------------------
SELECT producerId, groupId, producedPower, timestamp AS ts FROM ch_b5 INTO wB5
REPLAYABLE WITH HISTORY OF '1MB' WITH ACCURACY BOUND 5% SET(
    'MemoryStore->FileStore->LossyStore' AS REPLAY.STORE_ORDER,
    2048 AS REPLAY.MAX_BUFFER_COUNT
);
----
200001 243964861

SELECT producerId, groupId, producedPower, ts FROM ch_b5
FOR EVENT_TIME AS OF TIMESTAMP ALL INTO rB5;
----
200001 285778065
