# name: operator/replay/FileToCompressedStoreConfig.test
# description: Store stream via REPLAYABLE using the FileStore->CompressedStore chain and read back with time travel
# groups: [Replay]

SEQUENTIAL_EXECUTION

CREATE LOGICAL SOURCE stream(id UINT64, value UINT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,1000
2,1,1001
3,1,1002
4,2,2000

CREATE SINK sinkStore(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;
CREATE SINK sinkRead(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;

# 1: store rows using the FileStore->CompressedStore chain
SELECT id, value, ts FROM stream INTO sinkStore REPLAYABLE WITH HISTORY OF '32MB' SET(
    'FileStore->CompressedStore' AS REPLAY.STORE_ORDER
);
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

# 2: read back with time travel — data was compressed on the way into the tail store
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP '1001' INTO sinkRead;
----
2,1,1001
3,1,1002
4,2,2000


# 3: store rows on standalone CompressedStore
SELECT id, value, ts FROM stream INTO sinkStore REPLAYABLE WITH HISTORY OF '32MB' SET(
    'CompressedStore' AS REPLAY.STORE_ORDER
);
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

# 4 - read back with time travel from standalone CompressedStore
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP '1001' INTO sinkRead;
----
2,1,1001
3,1,1002
4,2,2000