# name: operator/replay/ConcurrentReads.test
# description: Tests thread safety of concurrent reads from a replay store
# groups: [Replay]

CREATE LOGICAL SOURCE stream(id UINT64, value UINT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,1000
2,1,1001
3,1,1002
4,2,2000

CREATE SINK sinkStore(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;
CREATE SINK sinkRead1(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;
CREATE SINK sinkRead2(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;
CREATE SINK sinkRead3(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;
CREATE SINK sinkRead4(stream.id UINT64, stream.value UINT64, stream.ts UINT64) TYPE File;

# Query 1: populate the replay store
SELECT id, value, ts FROM stream INTO sinkStore REPLAYABLE WITH HISTORY OF '64MB';
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

# Queries 2-5: concurrent reads from the same store, all depend on query 1
# Since they all have AFTER 1 but no dependency on each other, the runner executes them concurrently.
AFTER 1
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP ALL INTO sinkRead1;
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

AFTER 1
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP ALL INTO sinkRead2;
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

AFTER 1
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP ALL INTO sinkRead3;
----
1,1,1000
2,1,1001
3,1,1002
4,2,2000

AFTER 1
SELECT id, value, ts FROM stream FOR EVENT_TIME AS OF TIMESTAMP '1001' INTO sinkRead4;
----
2,1,1001
3,1,1002
4,2,2000